# Préproduction — modèle de /srv/sae501/preprod/.env sur le serveur (jamais commité).
# bootstrap-server.sh crée ce fichier et génère les valeurs marquées « générée » sans les afficher.
# Toutes les valeurs ci-dessous sont des exemples.

# Préfixe de tous les volumes et réseaux : ne jamais le modifier après la mise en service.
COMPOSE_PROJECT_NAME=sae501-preprod

# Domaine public : le site et son API (/api) y sont servis ensemble.
FRONTEND_DOMAIN=preprod.example.com
# Adresse reprise dans les liens des e-mails (activation, mot de passe).
FRONTEND_URL=https://preprod.example.com

# Générée.
APP_SECRET=replace-with-a-generated-value

MYSQL_DATABASE=sae501_preprod
MYSQL_USER=sae501_preprod
# Générées (hexadécimal : utilisables telles quelles dans DATABASE_URL).
MYSQL_ROOT_PASSWORD=replace-with-a-generated-value
MYSQL_PASSWORD=replace-with-a-generated-value

# Générée : protège la clé privée JWT créée sur le serveur dans secrets/jwt/.
JWT_PASSPHRASE=replace-with-a-generated-value

# E-mails envoyés par Brevo : une clé API par environnement (Brevo > SMTP & API).
MAILER_DSN=brevo+api://replace-with-your-brevo-api-key@default
# Expéditeur validé dans Brevo (SPF, DKIM et DMARC configurés sur le domaine).
MAILER_FROM=noreply-preprod@example.com

# File des messages asynchrones, consommée par le service worker.
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0
SYMFONY_TRUSTED_PROXIES=private_ranges
