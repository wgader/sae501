# Variables du développement local, lues par docker-compose.yml : copier en .env et compléter.

APP_ENV=dev
APP_SECRET=

MYSQL_DATABASE=sae501
MYSQL_USER=sae501
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
DATABASE_URL=mysql://sae501:MOT_DE_PASSE@mysql:3306/sae501?serverVersion=8.4&charset=utf8mb4

# Adresse du site dans le navigateur, reprise dans les liens des e-mails.
FRONTEND_URL=http://localhost:3000

# Les e-mails sont capturés par Mailpit : http://localhost:8025
MAILER_DSN=smtp://mailpit:1025
MAILER_FROM=noreply@feytiat.test

# Clés générées par « php bin/console lexik:jwt:generate-keypair » dans le conteneur app.
JWT_SECRET_KEY=/app/backend/config/jwt/private.pem
JWT_PUBLIC_KEY=/app/backend/config/jwt/public.pem
JWT_PASSPHRASE=
