# Recréés pendant le build : les copies locales (modules macOS) casseraient l'image Linux.
backend/vendor
frontend/node_modules
frontend/.next
frontend/out
backend/public/bundles
# Données locales : cache, journaux, fichiers déposés, résultats de tests.
backend/var
backend/public/uploads
frontend/test-results
frontend/playwright-report
# Secrets : les clés JWT sont montées en secrets Docker sur le serveur.
backend/config/jwt/*.pem
**/.env.local
**/.env.*.local
.git
