  <diagram id="architecture" name="Architecture Docker">
    <mxGraphModel adaptiveColors="auto"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="SAE501 — Next.js exporté + Symfony dans une image FrankenPHP" style="text;html=1;fontSize=20;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="230" y="0" width="640" height="40" as="geometry"/></mxCell><mxCell id="browser" value="Navigateur&lt;br&gt;&lt;small&gt;un seul domaine, appels en /api/...&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#F2F4F7;strokeColor=#B8C0CC;" vertex="1" parent="1"><mxGeometry x="440" y="50" width="220" height="56" as="geometry"/></mxCell><mxCell id="edge" value="Proxy d'entrée Caddy&lt;br&gt;&lt;small&gt;HTTPS Let's Encrypt · préprod et prod&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#F2F4F7;strokeColor=#B8C0CC;" vertex="1" parent="1"><mxGeometry x="440" y="140" width="220" height="56" as="geometry"/></mxCell><mxCell id="app" value="③ app — image unique (FrankenPHP)" style="swimlane;startSize=30;html=1;fontSize=14;fontStyle=1;fillColor=#E7F6EC;strokeColor=#8BCB9F;rounded=1;arcSize=4;" vertex="1" parent="1"><mxGeometry x="230" y="235" width="640" height="420" as="geometry"/></mxCell><mxCell id="caddy" value="&lt;b&gt;Caddy&lt;/b&gt;&lt;br&gt;&lt;small&gt;/etc/frankenphp/Caddyfile&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#FFFFFF;strokeColor=#9DB8F2;" vertex="1" parent="app"><mxGeometry x="200" y="45" width="240" height="60" as="geometry"/></mxCell><mxCell id="backend" value="Backend — /app/backend" style="swimlane;startSize=26;html=1;fontSize=14;fillColor=#FFFFFF;strokeColor=#D5DAE1;rounded=1;arcSize=4;" vertex="1" parent="app"><mxGeometry x="20" y="160" width="600" height="245" as="geometry"/></mxCell><mxCell id="front" value="Frontend" style="swimlane;startSize=26;html=1;fontSize=14;fillColor=#F6F9FF;strokeColor=#D5DAE1;rounded=1;arcSize=6;" vertex="1" parent="backend"><mxGeometry x="20" y=