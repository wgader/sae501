parameters:
    level: 5
    paths:
        - src
    ignoreErrors:
        - '#Property App\\Entity\\User::\$id \(int\|null\) is never assigned int#'
        # Signalée selon la version de PHPStan : ne pas échouer quand elle ne l’est plus.
        -
            message: '#Method App\\Kernel::getAllowedEnvs\(\) is unused#'
            reportUnmatched: false
        - '#Property App\\Entity\\Association::\$id \(int\|null\) is never assigned int#'
        - '#Property App\\Entity\\(DemandeStatusHistory|DemandeSubvention|DemandeSubventionLigneBudget|DocumentJustificatif|ExternalEventFile|Materiel|Notification|ReservationMateriel|ReservationMaterielLigne|ReservationSalle|Salle|StockAdjustment)::\$id \(int\|null\) is never assigned int#'
        - '#Property App\\Entity\\Materiel::\$stockTotal \(int\|null\) is never assigned null#'