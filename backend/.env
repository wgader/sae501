APP_ENV=dev
APP_SECRET=change-me-in-local-environment
DATABASE_URL="mysql://app:app@127.0.0.1:3306/sae501?serverVersion=8.4&charset=utf8mb4"
MAILER_DSN=null://null
FRONTEND_URL=http://localhost:3000

JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem
JWT_PASSPHRASE=change-me-in-local-environment
# En développement, sans worker, les messages asynchrones sont traités immédiatement (sync://)
# pour que les notifications arrivent dans Mailpit. Préproduction/production : doctrine + worker.
MESSENGER_TRANSPORT_DSN=sync://

# Origines autorisées à appeler l’API (expression régulière).
CORS_ALLOW_ORIGIN='^https?://(localhost|127\.0\.0\.1)(:[0-9]+)?$'

###> symfony/brevo-mailer ###
# MAILER_DSN=brevo+api://KEY@default
# MAILER_DSN=brevo+smtp://USERNAME:PASSWORD@default
