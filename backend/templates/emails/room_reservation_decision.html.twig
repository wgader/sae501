<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ title }}</title>
</head>
<body style="margin:0;padding:32px 16px;background:#F4F4F0;font-family:Arial,Helvetica,sans-serif;color:#000;">
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0">
    <tr><td align="center">
      <table role="presentation" width="600" cellpadding="0" cellspacing="0" style="max-width:600px;width:100%;background:#fff;">
        <tr><td style="padding:40px;background:#146E67;color:#fff;">
          <p style="margin:0 0 12px;color:#D8EC95;font-size:12px;font-weight:bold;letter-spacing:2px;text-transform:uppercase;">Espace Association · Salles Municipales{% if campaign %} · {{ campaign.seasonLabel }}{% endif %}</p>
          <h1 style="margin:0;font-size:26px;">{{ title }}</h1>
        </td></tr>
        <tr><td style="padding:40px;">
          <p>Bonjour {{ prenom }},</p>
          <p>{{ intro }}</p>
          {% if reservation.decisionComment %}
            <p style="margin:20px 0;padding:16px;background:#F4F4F0;border-left:4px solid #146E67;">
              <strong>Message de la mairie :</strong><br>{{ reservation.decisionComment|nl2br }}
            </p>
          {% endif %}
          {% include 'emails/_room_reservation_details.html.twig' %}
          <p style="margin-top:20px;font-size:14px;color:#555;">Retrouvez le détail de vos réservations depuis votre espace association.</p>
        </td></tr>
        <tr><td style="padding:24px 40px;background:#000;color:#fff;font-size:12px;">Mairie de Feytiat — Plateforme Associations</td></tr>
      </table>
    </td></tr>
  </table>
</body>
</html>
