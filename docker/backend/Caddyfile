{
    frankenphp
    order php_server before file_server
}

{$SERVER_NAME} {
    root * /app/public
    encode zstd br gzip

    @private_documents path /uploads/documents/*
    respond @private_documents 404

    # Le CORS est géré par Symfony (nelmio_cors, variable CORS_ALLOW_ORIGIN).

    php_server {
        # Chaque worker garde Symfony chargé en mémoire : leur nombre est borné (2 par défaut,
        # FRANKENPHP_WORKERS) pour que préproduction et production tiennent sur le même VPS.
        worker {
            file /app/public/index.php
            num {$FRANKENPHP_WORKERS:2}
        }
    }
}
