{
	# Adresse de contact Let’s Encrypt (expiration de certificat, incident).
	email {$ACME_EMAIL}
}

# En-têtes communs à tous les sites publics.
(common) {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		# Le site ne doit jamais être affiché dans un cadre (clickjacking) ni charger de plugin.
		X-Frame-Options "DENY"
		Content-Security-Policy "frame-ancestors 'none'; base-uri 'self'; object-src 'none'"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
		Cross-Origin-Opener-Policy "same-origin"
		-Server
	}
	log
}

# Un fichier par environnement, écrit par deploy.sh à partir de son .env.
import sites/*.caddy
