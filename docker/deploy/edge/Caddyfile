{
	# Adresse de contact Let’s Encrypt (expiration de certificat, incident).
	email {$ACME_EMAIL}
	# Proxys de confiance (plages Cloudflare si EDGE_CLOUDFLARE=1), générés par deploy.sh.
	import /etc/caddy/proxy/global.caddy

	# Journal système du proxy : certificats, erreurs de connexion, à partir de WARN.
	log {
		output file /data/logs/error.log {
			roll_size 10MiB
			roll_keep 5
			roll_keep_for 720h
		}
		format json
		level WARN
	}
}

# Tout accès en HTTP est renvoyé définitivement vers HTTPS (le défi Let's Encrypt reste servi).
http:// {
	redir https://{host}{uri} permanent
}

# Définit (origin_guard), vide sauf derrière Cloudflare ; généré par deploy.sh.
import /etc/caddy/proxy/guard.caddy

# En-têtes de sécurité communs à la préproduction et à la production.
(common) {
	import origin_guard
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		# Le site ne doit jamais être affiché dans un cadre (clickjacking) ni charger de plugin.
		X-Frame-Options "DENY"
		# Valeur par défaut : la CSP envoyée par l’application est conservée.
		?Content-Security-Policy "frame-ancestors 'none'; base-uri 'self'; object-src 'none'; form-action 'self'"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
		Cross-Origin-Opener-Policy "same-origin"
		# Aucun indice sur les logiciels en amont (Caddy ajoute « Via » à chaque réponse relayée).
		-Server
		-Via
		-X-Powered-By
	}
}

# Un fichier par environnement, écrit par deploy.sh à partir de son .env.
import sites/*.caddy
