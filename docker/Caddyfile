{
	frankenphp

	# Journal système : démarrage de Caddy, erreurs internes et erreurs PHP, à partir de WARN.
	log {
		output file /app/backend/var/log/caddy/error.log {
			roll_size 10MiB
			roll_keep 5
			roll_keep_for 720h
		}
		format json
		level WARN
	}

	servers {
		# Le proxy d'entrée est sur un réseau Docker privé : l'IP réelle du visiteur est celle
		# qu'il transmet dans X-Forwarded-For (champ client_ip des journaux).
		trusted_proxies static private_ranges
		client_ip_headers X-Forwarded-For
	}
}

{$SERVER_NAME::80} {
	root * /app/backend/public
	encode zstd br gzip

	# Journal d'accès : une ligne JSON par requête (méthode, chemin, statut, durée, IP réelle).
	log {
		output file /app/backend/var/log/caddy/access.log {
			roll_size 10MiB
			roll_keep 5
			roll_keep_for 720h
		}
		format json
		level INFO
	}

	header {
		# Complète la CSP inscrite dans chaque page : frame-ancestors n'est pas lu dans une balise <meta>.
		Content-Security-Policy "frame-ancestors 'none'"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	@api path /api /api/* /uploads/* /bundles/* /healthcheck.php
	@legacy_annexes path_regexp legacy ^/historique/([^/]+)/pieces-annexes$

	# Les règles s'appliquent dans l'ordre où elles sont écrites.
	route {
		# Anciennes adresses : liens déjà envoyés par e-mail et favoris.
		redir @legacy_annexes /historique/demande/pieces-annexes?id={re.legacy.1}&{query} permanent
		redir /admin/inscriptions /admin/inscription permanent
		redir /admin/associations /admin/association permanent
		redir /admin/salles /admin/salle permanent
		redir /admin/subventions /admin/subvention permanent
		redir /admin/agents /admin/agent permanent
		redir /admin/modules /admin/association permanent

		# /api/* et les images /uploads/* : Symfony, qui contrôle les droits de chaque compte.
		# Il reste en mémoire grâce aux workers FrankenPHP.
		php_server @api {
			worker {
				file /app/backend/public/index.php
				num {$FRANKENPHP_WORKERS:2}
			}
		}

		# /* : pages du front exportées par Next.js (/connexion est servi par connexion.html).
		try_files {path} {path}.html {path}/index.html
		file_server
	}

	handle_errors 404 {
		rewrite * /404.html
		file_server
	}
}
