APP_ENV=prod
APP_DEBUG=0
APP_SECRET=replace-with-a-long-random-value

API_DOMAIN=api.example.com
PUBLIC_API_URL=https://api.example.com

MYSQL_ROOT_PASSWORD=replace-with-a-strong-root-password
MYSQL_DATABASE=sae501
MYSQL_USER=sae501
MYSQL_PASSWORD=replace-with-a-strong-database-password
DATABASE_URL=mysql://sae501:replace-with-a-strong-database-password@mysql:3306/sae501?serverVersion=8.4&charset=utf8mb4

# Expression régulière des origines autorisées : uniquement le domaine public du frontend.
CORS_ALLOW_ORIGIN='^https://www\.example\.com$'
# E-mails envoyés par Brevo (bridge symfony/brevo-mailer). Une clé API distincte par
# environnement (préproduction et production), créée dans Brevo > SMTP & API.
MAILER_DSN=brevo+api://replace-with-your-brevo-api-key@default
# Adresse d’expéditeur validée dans Brevo (SPF, DKIM et DMARC configurés sur le domaine).
MAILER_FROM=noreply@example.com
# Adresse publique du frontend, utilisée dans les liens des e-mails (activation, mot de passe).
FRONTEND_URL=https://www.example.com
# File des messages asynchrones, consommée par le service messenger-worker.
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0

JWT_SECRET_KEY=/run/secrets/jwt_private_key
JWT_PUBLIC_KEY=/run/secrets/jwt_public_key
JWT_PASSPHRASE=replace-with-a-strong-passphrase
