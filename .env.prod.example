# Production — modèle de /srv/sae501/prod/.env sur le serveur (jamais commité).
# bootstrap-server.sh crée ce fichier sur le serveur et y génère les valeurs marquées « générée » ;
# elles ne sont jamais affichées. Les autres valeurs sont à renseigner sur le serveur.
# Toutes les valeurs ci-dessous sont des exemples sans valeur réelle.

# Préfixe de tous les volumes et réseaux : ne jamais le modifier après la mise en service.
COMPOSE_PROJECT_NAME=sae501-prod

# Domaines publics servis par le proxy d’entrée (certificats Let’s Encrypt automatiques).
FRONTEND_DOMAIN=www.example.com
API_DOMAIN=api.example.com
# Adresse publique du frontend, utilisée dans les liens des e-mails (activation, mot de passe).
FRONTEND_URL=https://www.example.com
# Expression régulière des origines autorisées : uniquement le domaine public du frontend.
CORS_ALLOW_ORIGIN='^https://www\.example\.com$'

# Images publiées par la CD ; les étiquettes sont choisies par deploy.sh à chaque déploiement.
BACKEND_IMAGE=ghcr.io/wgader/sae501/backend
FRONTEND_IMAGE=ghcr.io/wgader/sae501/frontend

# Générée.
APP_SECRET=replace-with-a-generated-value

MYSQL_DATABASE=sae501
MYSQL_USER=sae501
# Générées (hexadécimal : utilisables telles quelles dans DATABASE_URL).
MYSQL_ROOT_PASSWORD=replace-with-a-generated-value
MYSQL_PASSWORD=replace-with-a-generated-value

# Générée : protège la clé privée JWT créée sur le serveur dans secrets/jwt/.
JWT_PASSPHRASE=replace-with-a-generated-value

# E-mails envoyés par Brevo (bridge symfony/brevo-mailer). Une clé API distincte par
# environnement, créée dans Brevo > SMTP & API.
MAILER_DSN=brevo+api://replace-with-your-brevo-api-key@default
# Adresse d’expéditeur validée dans Brevo (SPF, DKIM et DMARC configurés sur le domaine).
MAILER_FROM=noreply@example.com

# File des messages asynchrones, consommée par le service messenger-worker.
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0
# Le proxy d’entrée joint le backend par un réseau Docker privé (variable lue nativement par Symfony).
SYMFONY_TRUSTED_PROXIES=private_ranges
