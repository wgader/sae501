APP_ENV=prod
APP_DEBUG=0
APP_SECRET=replace-with-a-long-random-value

API_DOMAIN=api.example.com
PUBLIC_API_URL=https://api.example.com

MYSQL_ROOT_PASSWORD=replace-with-a-strong-root-password
MYSQL_DATABASE=sae501
MYSQL_USER=sae501
MYSQL_PASSWORD=replace-with-a-strong-database-password
DATABASE_URL=mysql://sae501:replace-with-a-strong-database-password@mysql:3306/sae501?serverVersion=8.4&charset=utf8mb4

CORS_ALLOW_ORIGIN=https://www.example.com
